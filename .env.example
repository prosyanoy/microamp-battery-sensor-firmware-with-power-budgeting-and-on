# Copy to .env and `source` it (optional). Every value has a safe local default.
MICROAMP_PYTHON=python3          # interpreter used to launch the sensor simulator
MICROAMP_DESIGN=wom              # polling | fifo | wom
MICROAMP_SCENARIO=day            # day | drive | parked
MICROAMP_SEED=7
MICROAMP_DURATION_S=600          # simulated seconds
MICROAMP_LOG=out/microamp.log    # nanopb event log written by the "radio"
MICROAMP_BATTERY_MAH=225         # CR2032-class cell
